{
  "name": "spec-fleet",
  "version": "0.7.0",
  "private": true,
  "description": "SpecFleet — a Spec Kit extension that adds charters, shared scratchpad working memory, and charter-compliance review to core Spec Kit phases.",
  "type": "module",
  "scripts": {
    "build": "echo \"No standalone CLI build; SpecFleet ships as a Spec Kit extension.\"",
    "test": "vitest run tests/unit/extension.test.ts",
    "test:unit": "vitest run tests/unit/extension.test.ts",
    "format": "prettier --write '*.md' 'docs/**/*.md' 'commands/**/*.md' 'tests/**/*.ts'",
    "version:sync": "node scripts/sync-docs-version.mjs",
    "version": "node scripts/sync-docs-version.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.9.4",
    "vitest": "^4.1.9"
  },
  "license": "MIT",
  "author": "Sepehr Pakbaz",
  "homepage": "https://github.com/pakbaz/spec-fleet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pakbaz/spec-fleet.git"
  },
  "bugs": {
    "url": "https://github.com/pakbaz/spec-fleet/issues"
  },
  "keywords": [
    "spec-kit",
    "spec-driven",
    "extension",
    "agents",
    "charters",
    "cross-model-review",
    "scratchpad",
    "governance"
  ]
}
